# ─────────────────────────────────────────────────────────────
# Trilha · variáveis de ambiente
# Copie para .env.local (dev) e cadastre as mesmas no Vercel (Settings → Environment Variables).
# NEXT_PUBLIC_* vão para o navegador: só valores públicos. O resto fica só no servidor.
# ─────────────────────────────────────────────────────────────

# ── Públicas (a segurança vem das políticas RLS do banco) ──
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# URL pública do app (usada em links de convite e retorno do login)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Mostra os botões de login social só depois de configurar o provedor no Supabase (1 = mostrar)
NEXT_PUBLIC_AUTH_GOOGLE=0
NEXT_PUBLIC_AUTH_APPLE=0
# Link mágico por e-mail só funciona para seus amigos depois de configurar um SMTP próprio no Supabase
NEXT_PUBLIC_AUTH_MAGIC_LINK=0
# Chave pública VAPID para notificações push (gerada com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Somente servidor (NUNCA com prefixo NEXT_PUBLIC_) ──
# Secret key do Supabase: usada só pela rotina diária de notificações (api/cron/daily).
SUPABASE_SECRET_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
# Protege o endpoint do cron (o Vercel envia "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=

# IA (opcional). Sem nenhuma chave, o app usa dicionário e regras locais, sem etiqueta IA.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Limite de chamadas de IA por usuário por dia (protege a cota gratuita)
AI_DAILY_LIMIT_PER_USER=60

# Distâncias reais por estrada (opcional; sem chave mostra distância em linha reta, identificada)
ORS_API_KEY=
